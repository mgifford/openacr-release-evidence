{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global accessibility context statistic",
  "type": "object",
  "required": ["id", "organization", "measure", "value", "geography", "source_publication_date", "source_url", "limitations"],
  "properties": {
    "id": {"type": "string"},
    "organization": {"type": "string"},
    "measure": {"type": "string"},
    "value": {"type": "integer"},
    "percentage": {"type": "number"},
    "geography": {"type": "string"},
    "population_definition": {"type": "string"},
    "source_publication_date": {"type": "string"},
    "source_url": {"type": "string"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
