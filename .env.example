# Optional: path to an installed drupalorg-cli binary.
# Install it outside this repository and point this variable at it.
ACR_DRUPALORG_BIN=

# AI is NOT used by the current evidence pipeline.
# These values are for opt-in experiments only; never expose them to the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct

# GitHub Issues and Jira are deferred. The current pipeline does not use a
# GitHub API token.
